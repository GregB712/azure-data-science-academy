# Clerk authentication (optional).
# Copy to `.env` and set your key to enable sign in / sign up and saved progress:
#   cp .env.example .env
# Without this key the dashboard runs with no auth and progress stays in localStorage.
# This is the *publishable* key (safe to expose in the browser), not a secret.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
