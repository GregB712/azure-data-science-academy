# Copy to lab.env (git-ignored) and edit:  cp lab.env.example lab.env
# All scripts in scripts/ read this file. Never put secrets here; none are needed.

# Region close to you that offers the services you need (az account list-locations -o table)
AZ_LOCATION=westeurope
# Resource group for this lab only. Deleting it deletes everything the lab created.
AZ_RESOURCE_GROUP=rg-adsa-lab01
# Lowercase letters/digits only, 3-11 chars; a random suffix is added to make it globally unique
STORAGE_PREFIX=stadsa
# Your identity for tags and budget alerts
OWNER_TAG=your-alias
BUDGET_EMAIL=you@example.com
# Monthly budget for the lab resource group, in your billing currency
BUDGET_AMOUNT=10
# Optional: pin the subscription the scripts must use (recommended if you have several)
AZ_SUBSCRIPTION_ID=
